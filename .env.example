# Copy to .env and fill with local secrets as needed. Never commit .env.
APP_PORT=8080
DB_URL=jdbc:h2:mem:xeditarchive;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=

# Music recognition (AudD). Server-side only: never expose to a frontend or commit it.
# Get a token (trial or subscription) at https://dashboard.audd.io.
# Without a token, jobs wait in RETRY_WAIT (no X fetch, no retries used).
# "test" is AudD's public demo token: heavily limited, local checks only.
AUDD_ENABLED=true
AUDD_API_TOKEN=

# Media provider: none | x-api | local-sample
MEDIA_PROVIDER=none
# x-api: app-only Bearer token from https://console.x.com (pay-per-use credits required)
X_BEARER_TOKEN=
# local-sample: directory of media you are permitted to use, named <postId>.mp4
MEDIA_SAMPLE_DIR=

# Limits
MEDIA_MAX_DOWNLOAD_BYTES=104857600
MEDIA_MAX_VIDEO_DURATION_SECONDS=600
MEDIA_DOWNLOAD_TIMEOUT=60s
MEDIA_FFMPEG_TIMEOUT=60s
MEDIA_ALLOWED_HOSTS=video.twimg.com
JOBS_MAX_ATTEMPTS=5
